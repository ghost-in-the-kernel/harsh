  "findings": [
    {
      "code": "SITE-24",
      "severity": "minor",
      "listed": [
        "missing header",
        "missing headers"
      ],
      "title": "3 security headers no page sends",
      "where": [
        {
          "url": "https://harsh.civicease.systems/",
          "says": "no page of the site sends Content-Security-Policy (without it, nothing limits which scripts a page may run)"
        },
        {
          "url": "https://harsh.civicease.systems/",
          "says": "no page of the site sends X-Frame-Options or frame-ancestors (without it, another site can frame the page to trick a click)"
        },
        {
          "url": "https://harsh.civicease.systems/",
          "says": "no page of the site sends X-Content-Type-Options: nosniff (without it, a browser may guess a file's type from its content)"
        }
      ],
      "why": "Each header closes off one way the site could be misused (a downgrade to http, a script slipped in, the site framed in another to trick a click). A missing one is a weaker defence, not a sign the site has been attacked; security reviews ask for them, and each costs a line of server configuration.",
      "fix": "Add the missing headers in the web server or the CDN (one setting each), starting with Content-Security-Policy."
    },
    {
      "code": "SITE-28",
      "severity": "minor",
      "listed": [
        "address",
        "addresses"
      ],
      "title": "The site has no sitemap search engines can read",
      "where": [
        {
          "url": "https://harsh.civicease.systems/sitemap.xml",
          "says": "answered 404"
        }
      ],
      "why": "A sitemap tells search engines every page to index, and how fresh each is; without one they find pages only by following links, and one listing wrong addresses spends their visits on errors.",
      "fix": "Publish /sitemap.xml listing each page's final address (most site builders and CMSs have a setting or plugin for it), and name it in robots.txt (Sitemap: ...)."
    },
    {
      "code": "SITE-29",
      "severity": "minor",
      "listed": [
        "address",
        "addresses"
      ],
      "title": "The site publishes no security.txt, the file that tells security researchers whom to contact",
      "where": [
        {
          "url": "https://harsh.civicease.systems/.well-known/security.txt",
          "says": "answered 404"
        }
      ],
      "why": "Researchers who find a security problem look for /.well-known/security.txt to know whom to tell (RFC 9116); without it they may not report it, or report it publicly.",
      "fix": "Publish /.well-known/security.txt with a Contact line (an email address or a form) and an Expires line."
    }
  ]
